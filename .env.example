# String de conexão do Neon (Postgres)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="gere-com: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Senha do painel /admin (não tem relação com contas de salão)
ADMIN_PASSWORD="troque-por-uma-senha-forte"

# Senha do painel administrativo, em hash bcrypt.
# Gere com: npm run hash-admin
# Preferida sobre ADMIN_PASSWORD. Com as duas configuradas, o hash vence —
# mas deixar a senha em texto puro nao traz beneficio, entao remova a antiga.
ADMIN_PASSWORD_HASH=""
