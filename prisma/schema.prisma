// ────────────────────────────────────────────────────────────────────────────
// Dilon Beauty — Schema multi-tenant
// Cada Salon é um cliente (tenant). Todo dado sensível carrega salonId
// e TODA query no app deve ser filtrada por esse campo — é isso que
// garante isolamento entre clientes dentro do mesmo banco.
// ────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  STARTER
  PROFISSIONAL
  CLINIC
}

enum Role {
  OWNER // dono do salão, acesso total ao tenant
  STAFF // profissional/funcionário, acesso restrito
}

enum AppointmentStatus {
  AGUARDANDO
  CONFIRMADO
  CONCLUIDO
  CANCELADO
}

// ─── FINANCEIRO ────────────────────────────────────────────────────────────
enum FinanceOwner {
  PJ // conta/gasto da empresa (CNPJ)
  PF // conta/gasto pessoal do dono (CPF)
}

enum FinanceFlow {
  ENTRADA
  SAIDA
}

enum FinanceSource {
  MANUAL
  IMPORTACAO
}

// Natureza do gasto, pra montar o lucro real e separar o que é custo do negócio
// do que é retirada do dono. RETIRADA fica de fora do custo de propósito:
// pró-labore não é despesa operacional, é distribuição do lucro — tratá-lo como
// custo faz o negócio parecer menos lucrativo do que é.
enum FinanceCategoryKind {
  RECEITA
  FIXA // sai todo mês mesmo sem vender: aluguel, internet, salário
  VARIAVEL // acompanha o movimento: mercadoria, comissão, marketing
  IMPOSTO
  DIVIDA
  RETIRADA
}

// PAGO = já passou pelo banco. PENDENTE = compromisso assumido que ainda vai
// vencer — é o que separa "saldo" de "dinheiro livre".
enum FinanceStatus {
  PAGO
  PENDENTE
}

// ─── TENANT ────────────────────────────────────────────────────────────────
model Salon {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique // usado em links públicos de agendamento, ex: /agendar/carla-hair
  plan      Plan     @default(STARTER)
  whatsapp  String? // número usado no botão de redirecionamento
  address   String?
  openTime  String   @default("09:00") // horário de abertura, usado pra calcular horários livres no link público
  closeTime String   @default("19:00") // horário de fechamento
  logoUrl   String? // link de uma imagem já hospedada (ex: Google Drive, Imgur) — sem upload de arquivo por enquanto
  active      Boolean   @default(true) // desativado pelo admin = login e link público de agendamento bloqueados
  trialEndsAt DateTime? // só informativo — acompanhamento é manual, não bloqueia acesso sozinho
  metaCaixa   Float? // meta de reserva de caixa do passo 6 do método dos 30 minutos
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  users         User[]
  professionals Professional[]
  services      Service[]
  clients       Client[]
  appointments  Appointment[]

  financeCategories    FinanceCategory[]
  bankImports          BankImport[]
  financeTransactions  FinanceTransaction[]
}

// ─── AUTH ──────────────────────────────────────────────────────────────────
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(OWNER)
  createdAt    DateTime @default(now())

  salonId String
  salon   Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@index([salonId])
}

// ─── CORE ──────────────────────────────────────────────────────────────────
model Professional {
  id     String  @id @default(cuid())
  name   String
  role   String? // ex: "Cabeleireira", "Manicure"
  active Boolean @default(true)

  salonId String
  salon   Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)

  appointments Appointment[]

  @@index([salonId])
}

model Service {
  id          String  @id @default(cuid())
  name        String
  price       Float
  durationMin Int     @default(60)
  active      Boolean @default(true)

  salonId String
  salon   Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)

  appointments Appointment[]

  @@index([salonId])
}

model Client {
  id    String  @id @default(cuid())
  name  String
  phone String?
  notes String?

  salonId String
  salon   Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)

  appointments Appointment[]

  @@index([salonId])
}

model Appointment {
  id     String            @id @default(cuid())
  date   DateTime
  time   String // "14:30" — mantido como string simples para exibição direta
  status AppointmentStatus @default(AGUARDANDO)
  price  Float

  salonId String
  salon   Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([salonId, date])
}

// Categoria de receita/despesa. "owner" fixo (PF ou PJ) restringe a categoria
// pra um lado só (ex: "Pró-labore Recebido" só existe do lado PF); owner nulo
// = serve pros dois (ex: "Transferência entre contas").
model FinanceCategory {
  id       String              @id @default(cuid())
  name     String
  flow     FinanceFlow
  owner    FinanceOwner?
  kind     FinanceCategoryKind @default(VARIAVEL)
  keywords String? // termos separados por vírgula usados na sugestão automática ao importar extrato
  isSystem Boolean             @default(false) // categoria padrão criada automaticamente, não pode ser apagada

  salonId String
  salon   Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)

  transactions FinanceTransaction[]

  @@unique([salonId, name, flow])
  @@index([salonId])
}

// Um extrato bancário importado de uma vez (um arquivo = um import).
// Tudo que ele carrega já nasce marcado como PF ou PJ, porque essa é a
// separação que interessa: a conta de origem do extrato.
model BankImport {
  id         String       @id @default(cuid())
  fileName   String
  owner      FinanceOwner
  bankLabel  String? // rótulo livre que o usuário dá pro banco/conta, ex: "Nubank PJ"
  rowCount   Int          @default(0)
  importedAt DateTime     @default(now())

  salonId String
  salon   Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)

  transactions FinanceTransaction[]

  @@index([salonId])
}

model FinanceTransaction {
  id            String        @id @default(cuid())
  date          DateTime // data em que o dinheiro entrou/saiu de fato (regime de caixa)
  // Mês de referência no formato "YYYY-MM" (regime de competência). Nasce igual
  // ao mês de `date`, mas pode ser corrigido: a conta de luz paga dia 05/10 que
  // se refere ao consumo de setembro tem competência "2026-09". É por ela que a
  // análise mensal filtra — senão o gasto aparece no mês errado.
  competencia   String
  description   String
  amount        Float // sempre positivo — o sinal vem do campo flow
  flow          FinanceFlow
  owner         FinanceOwner
  status        FinanceStatus @default(PAGO)
  dueDate       DateTime? // vencimento, quando o lançamento ainda está PENDENTE
  source        FinanceSource @default(MANUAL)
  paymentMethod String?
  counterparty  String? // cliente/fornecedor
  notes         String?
  externalId    String? // hash estável da linha (FITID do OFX ou data+descrição+valor do CSV), evita importar a mesma linha duas vezes

  categoryId String?
  category   FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  importId String?
  import   BankImport? @relation(fields: [importId], references: [id], onDelete: SetNull)

  salonId String
  salon   Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([salonId, externalId])
  @@index([salonId, date])
  @@index([salonId, owner])
  @@index([salonId, competencia])
  @@index([salonId, status, dueDate])
}
