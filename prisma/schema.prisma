// ────────────────────────────────────────────────────────────────────────────
// Dilon Beauty — Schema multi-tenant
// Cada Salon é um cliente (tenant). Todo dado sensível carrega salonId
// e TODA query no app deve ser filtrada por esse campo — é isso que
// garante isolamento entre clientes dentro do mesmo banco.
// ────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  STARTER
  PROFISSIONAL
  CLINIC
}

enum Role {
  OWNER // dono do salão, acesso total ao tenant
  STAFF // profissional/funcionário, acesso restrito
}

enum AppointmentStatus {
  AGUARDANDO
  CONFIRMADO
  CONCLUIDO
  CANCELADO
}

// ─── TENANT ────────────────────────────────────────────────────────────────
model Salon {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique // usado em links públicos de agendamento, ex: /agendar/carla-hair
  plan      Plan     @default(STARTER)
  whatsapp  String? // número usado no botão de redirecionamento
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  professionals Professional[]
  services      Service[]
  clients       Client[]
  appointments  Appointment[]
}

// ─── AUTH ──────────────────────────────────────────────────────────────────
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(OWNER)
  createdAt    DateTime @default(now())

  salonId String
  salon   Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@index([salonId])
}

// ─── CORE ──────────────────────────────────────────────────────────────────
model Professional {
  id     String  @id @default(cuid())
  name   String
  role   String? // ex: "Cabeleireira", "Manicure"
  active Boolean @default(true)

  salonId String
  salon   Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)

  appointments Appointment[]

  @@index([salonId])
}

model Service {
  id          String @id @default(cuid())
  name        String
  price       Float
  durationMin Int    @default(60)

  salonId String
  salon   Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)

  appointments Appointment[]

  @@index([salonId])
}

model Client {
  id    String  @id @default(cuid())
  name  String
  phone String?
  notes String?

  salonId String
  salon   Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)

  appointments Appointment[]

  @@index([salonId])
}

model Appointment {
  id     String            @id @default(cuid())
  date   DateTime
  time   String // "14:30" — mantido como string simples para exibição direta
  status AppointmentStatus @default(AGUARDANDO)
  price  Float

  salonId String
  salon   Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([salonId, date])
}
